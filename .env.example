# .env 예시 파일 — 실제 키를 채워 .env 로 복사해 사용하세요.
# (.env 는 git에 올라가지 않습니다.)

# OpenAI API 키 (임베딩 / gpt-4o 답변 생성에 사용)
OPENAI_API_KEY=sk-여기에_실제_키

# Supabase (pgvector) — rag.py 의 match_sermons RPC 검색에 필수.
# 값 출처: Supabase 대시보드 → Project Settings → API
#   SUPABASE_URL              = Project URL (https://<id>.supabase.co)
#   SUPABASE_SERVICE_ROLE_KEY = service_role 키 (⚠️ anon 아님, 서버 전용 비밀)
SUPABASE_URL=https://여기_프로젝트id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_키

# (선택) 전사 교정 모델. 미지정 시 gpt-4o-mini 사용.
# CORRECT_MODEL=gpt-4o-mini
